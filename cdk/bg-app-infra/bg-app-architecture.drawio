        <!-- ECS → RDS -->
        <mxCell id="arr-ecs-rds" value=":5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeColor=#e65100;strokeWidth=2;" edge="1" source="fargate" target="rds" parent="1">
          <mxGeometry relative="1" as="geometry"/>
