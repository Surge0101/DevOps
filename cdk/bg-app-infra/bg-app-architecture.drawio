        <mxCell id="arr-vpc-tgw" value="TGW Attachment  |  10.1.0.0/16 ↔ 10.0.0.0/16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=8 4;endArrow=open;endFill=0;startArrow=open;startFill=0;strokeColor=#3f51b5;strokeWidth=2;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="vpc" target="tgw" parent="1">
