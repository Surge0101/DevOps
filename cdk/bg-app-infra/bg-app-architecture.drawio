        <mxCell id="arr-alb-cognito" value="Cognito Auth Action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=5 3;endArrow=open;endFill=0;startArrow=open;startFill=0;strokeColor=#7b1fa2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="alb" target="cognito" parent="1">
          <mxGeometry relative="1" as="geometry"/>
