        <!-- GlobalStack Cognito Cert → Cognito User Pool -->
        <mxCell id="arr-glb-cognito" value="cert ARN via context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=5 3;endArrow=open;endFill=0;strokeColor=#7c3aed;" edge="1" source="acm-cognito-cert" target="cognito" parent="1">
