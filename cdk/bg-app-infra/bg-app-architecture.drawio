        <mxCell id="arr-ecs-endpoints" value="AWS API calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=4 3;endArrow=open;endFill=0;strokeColor=#2e7d32;" edge="1" source="fargate" target="vpc-endpoints" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ECR → ECS (image pull via endpoints) -->
        <mxCell id="arr-ecr-ecs" value="Image pull (via ECR endpoints)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;dashed=1;dashPattern=5 3;endArrow=open;endFill=0;strokeColor=#00695c;" edge="1" source="ecr" target="fargate" parent="1">
          <mxGeometry relative="1" as="geometry"/>
