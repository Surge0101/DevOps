        <mxCell id="arr-acm-alb" value="TLS cert attached" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=5 3;endArrow=open;endFill=0;strokeColor=#7c3aed;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" source="acm-alb" target="alb" parent="1">
